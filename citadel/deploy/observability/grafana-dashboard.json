{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping CITADEL /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "CITADEL — Service Overview",
  "uid": "citadel-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["citadel", "security"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(citadel_uptime_seconds, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Instances up",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "count(up{job=~\"citadel.*\"} == 1)", "datasource": "${DS_PROMETHEUS}" } ]
    },
    {
      "id": 2,
      "title": "Active sessions",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [ { "refId": "A", "expr": "sum(citadel_active_sessions{instance=~\"$instance\"})", "datasource": "${DS_PROMETHEUS}" } ]
    },
    {
      "id": 3,
      "title": "Resident memory (RSS)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1500000000 }, { "color": "red", "value": 1900000000 } ] } } },
      "targets": [ { "refId": "A", "expr": "max(citadel_resident_memory_bytes{instance=~\"$instance\"})", "datasource": "${DS_PROMETHEUS}" } ]
    },
    {
      "id": 4,
      "title": "5xx error ratio",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(rate(citadel_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(citadel_http_requests_total[5m])), 0.001)", "datasource": "${DS_PROMETHEUS}" } ]
    },
    {
      "id": 5,
      "title": "HTTP requests/sec by status class",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [ { "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(citadel_http_requests_total[5m]))", "datasource": "${DS_PROMETHEUS}" } ]
    },
    {
      "id": 6,
      "title": "Resident memory over time",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [ { "refId": "A", "legendFormat": "{{instance}}", "expr": "citadel_resident_memory_bytes{instance=~\"$instance\"}", "datasource": "${DS_PROMETHEUS}" } ]
    },
    {
      "id": 7,
      "title": "Scans vs scan errors (rate)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "legendFormat": "scans", "expr": "sum(rate(citadel_scans_total[5m]))", "datasource": "${DS_PROMETHEUS}" },
        { "refId": "B", "legendFormat": "errors", "expr": "sum(rate(citadel_scan_errors_total[5m]))", "datasource": "${DS_PROMETHEUS}" }
      ]
    },
    {
      "id": 8,
      "title": "Logins/sec",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [ { "refId": "A", "legendFormat": "{{result}}", "expr": "sum by (result) (rate(citadel_logins_total[5m]))", "datasource": "${DS_PROMETHEUS}" } ]
    }
  ]
}
