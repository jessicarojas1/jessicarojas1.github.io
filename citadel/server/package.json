{
  "name": "citadel-server",
  "version": "1.0.0",
  "private": true,
  "description": "CITADEL deep-scan backend — runs real open-source security scanners (Semgrep, Bandit, Trivy, Syft, Grype, Gitleaks, ClamAV) and serves the CITADEL SPA.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js && node --test test/lib.test.js test/api.test.js test/cli.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/lib.test.js test/cli.test.js",
    "test:ui": "node test/ui.playwright.test.js",
    "test:coverage:gate": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=70 --test-coverage-branches=60 test/lib.test.js test/cli.test.js",
    "lint": "cd .. && server/node_modules/.bin/eslint js server scripts cli"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "adm-zip": "^0.6.0",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0"
  },
  "optionalDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "playwright-core": "^1.61.1"
  }
}
