# REDOUBT — environment template. Copy to .env for LOCAL DEV ONLY.
# NEVER commit a real .env. In production, supply these via the container
# orchestrator or a secret manager (Key Vault / AWS Secrets Manager / Vault).

# --- Runtime ---------------------------------------------------------------
APP_ENV=discovery            # discovery | production
PORT=8080

# --- Portal database (PostgreSQL) ------------------------------------------
# DATABASE_URL=postgres://redoubt:CHANGEME@localhost:5432/redoubt?sslmode=require

# --- Microsoft cloud (GCC High — note the .us endpoints) -------------------
MS_CLOUD=USGovernment
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.us
GRAPH_BASE_URL=https://graph.microsoft.us
GRAPH_SCOPES=https://graph.microsoft.us/.default

# --- Entra ID app registration (GCC High) ----------------------------------
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=CHANGEME        # store in a secret manager, not here, in prod
# ENTRA_REDIRECT_URI=https://portal.example.us/auth/callback
