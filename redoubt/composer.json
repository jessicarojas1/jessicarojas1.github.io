{
  "name": "gmre/redoubt",
  "description": "REDOUBT — GMRE Program Portal Framework. Discovery-phase scaffold (PHP, Docker/Render deployable).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "Redoubt\\": "app/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:8080 -t public",
    "health": "curl -fsS http://localhost:8080/health || exit 1"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
