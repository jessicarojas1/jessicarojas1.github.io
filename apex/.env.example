# Copy to .env for local development (never commit .env)

# In production, include an sslmode to force TLS to the DB, e.g. append
# ?sslmode=require (or verify-full with a CA) — the app defaults to
# sslmode=require when APP_ENV=production and none is specified.
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex
JWT_SECRET=change-me-to-a-long-random-string
APP_ENV=development

# Set to 1 (NON-production only) to accept the well-known seed PINs
# (rojas/1231, smith/112233, brown/999999). Ignored entirely when
# APP_ENV=production. Leave at 0 and run scripts/hash-pins.php instead.
APEX_ALLOW_DEFAULT_PINS=0

# Login brute-force throttle (auth_events-backed). Block an identity or client
# IP after APEX_LOGIN_MAX_ATTEMPTS failed logins within APEX_LOGIN_WINDOW_MIN
# minutes. Set APEX_LOGIN_MAX_ATTEMPTS=0 to disable throttling.
APEX_LOGIN_MAX_ATTEMPTS=5
APEX_LOGIN_WINDOW_MIN=15
