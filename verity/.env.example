# Copy to .env for local development. Never commit the real .env file.

APP_ENV=development

# PostgreSQL connection string. Required for any page/feature beyond the
# login screen — the app degrades honestly (not fake data) when unset.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/verity_dev

# Checks new passwords against the Have I Been Pwned Pwned Passwords range
# API (k-anonymity — only a 5-char hash prefix ever leaves this server; see
# Auth::isPasswordBreached()). Fails open on any network error/timeout, so
# a third-party outage never blocks sign-in or password changes. Set to
# false for an air-gapped deployment with no outbound internet — see
# deployments/AIRGAPPED.md.
PASSWORD_BREACH_CHECK_ENABLED=true

# --- Microsoft Entra ID GCC High (NOT YET WIRED TO A SIGN-IN FLOW) ---------
# Section 5 of the build directive requires GCC High, never the commercial
# graph.microsoft.com/login.microsoftonline.com endpoints. These values are
# read by Config but there is no SSO flow consuming them yet in this build —
# see docs/GCC_HIGH_INTEGRATION.md. Leave unset for local development.
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.us
# GRAPH_BASE_URL=https://graph.microsoft.us
# AZURE_PORTAL_URL=https://portal.azure.us
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=
