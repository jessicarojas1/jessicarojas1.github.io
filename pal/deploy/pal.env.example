# Runtime configuration for deploy/compose.yaml. Copy to deploy/pal.env (never commit it).
# Every variable is documented in deployments/SINGLE_LINUX_SERVER.md.

APP_SECRET=                      # openssl rand -hex 32
PAL_BASE_URL=https://pal.example.internal
# Base URL Symfony uses for URLs generated outside a request (console, worker). Same as PAL_BASE_URL.
DEFAULT_URI=https://pal.example.internal
TRUSTED_HOSTS=^pal\.example\.internal$
# Set to the exact IP/CIDR of your TLS reverse proxy, and make that proxy OVERWRITE
# X-Forwarded-For (nginx: proxy_set_header X-Forwarded-For $remote_addr). With the broad
# private_ranges default, internal clients can spoof their IP (rate limits, audit client_ip).
TRUSTED_PROXIES=172.18.0.1

# Runtime role (least privilege) and migration role (schema owner). See deploy/sql/roles.sql.
DATABASE_URL=postgresql://pal_app:CHANGE_ME@db:5432/pal?serverVersion=17&charset=utf8
DATABASE_URL_MIGRATIONS=postgresql://pal_owner:CHANGE_ME@db:5432/pal?serverVersion=17&charset=utf8
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# The migrate step re-applies the audit-trail revokes to this runtime role after every migration.
PAL_APP_DB_ROLE=pal_app

OIDC_AUTHORITY=https://login.microsoftonline.com
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Certificate credential (recommended): mounted by compose.yaml from deploy/secrets/.
# Leave OIDC_CLIENT_SECRET empty when using it.
OIDC_CLIENT_CERT_PATH=/run/secrets/pal_oidc_cert
OIDC_CLIENT_KEY_PATH=/run/secrets/pal_oidc_key
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

PAL_DEFAULT_TIMEZONE=America/Denver
PAL_SESSION_IDLE_SECONDS=3600
PAL_SESSION_ABSOLUTE_SECONDS=43200
PAL_BOOTSTRAP_ADMIN_OIDS=
PAL_AUDIT_ANCHOR_DIR=
LOG_LEVEL=info
