# Tests run at level 6 by decision: at max, findings are almost entirely "mixed from
# json_decode()" inside assertions, which adds noise without catching defects.
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: 6
    paths:
        - tests
    excludePaths:
        # Standalone helper script run as a child process (intentional infinite server loop).
        - tests/Support/fake-clamd.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    tmpDir: var/phpstan-tests
    ignoreErrors:
        # This handler exists only in the test container (config/packages/monolog.yaml, when@test);
        # PHPStan reads the dev container, so it cannot see it. The test asserts its type at runtime.
        -
            identifier: symfonyContainer.serviceNotFound
            path: tests/Integration/AuditForwardTest.php
            count: 1
