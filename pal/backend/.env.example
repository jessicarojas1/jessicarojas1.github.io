# PAL backend configuration template. Copy to .env and put real values in
# .env.local (never committed) or in real environment variables, which always win.
# This file must never contain secrets.

APP_ENV=dev
# Required. Generate with: openssl rand -hex 32
APP_SECRET=
DEFAULT_URI=http://localhost:5173

# PostgreSQL 16+ (17 in production). serverVersion must match the server.
DATABASE_URL="postgresql://pal:pal@127.0.0.1:5432/pal_dev?serverVersion=16&charset=utf8"

# Durable queue in PostgreSQL (Symfony Messenger Doctrine transport). Tables come from migrations.
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"

# Public origin users reach PAL on (scheme + host [+ port]); used to build the OIDC redirect URI.
PAL_BASE_URL=http://localhost:5173
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-* headers.
TRUSTED_PROXIES=127.0.0.1
# Regex of allowed Host headers, e.g. '^pal\.example\.internal$'.
TRUSTED_HOSTS='^(localhost|127\.0\.0\.1)$'

# Session cookie. Use __Host-pal_session with PAL_SESSION_COOKIE_SECURE=1 behind TLS.
PAL_SESSION_COOKIE_NAME=pal_session
PAL_SESSION_COOKIE_SECURE=0
PAL_SESSION_IDLE_SECONDS=3600
PAL_SESSION_ABSOLUTE_SECONDS=43200

# Organisation default timezone for scheduling (decision D6a).
PAL_DEFAULT_TIMEZONE=America/Denver

# Entra ID (OIDC sign-in + read-only Graph group sync, decision D18).
OIDC_AUTHORITY=https://login.microsoftonline.com
OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Use EITHER a client secret (development) OR a certificate (production, recommended).
OIDC_CLIENT_SECRET=
OIDC_CLIENT_CERT_PATH=
OIDC_CLIENT_KEY_PATH=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Comma-separated Entra object IDs granted System Administrator before any group
# mapping exists. Remove once role mappings are configured.
PAL_BOOTSTRAP_ADMIN_OIDS=

# Optional directory where `pal:audit:verify --anchor` appends the audit chain head.
# Point it at write-once storage owned by another team.
PAL_AUDIT_ANCHOR_DIR=

LOG_LEVEL=info
