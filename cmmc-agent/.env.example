ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional configuration (safe defaults shown; do not commit real secrets) ──
# Web server port (default 5050; Render uses 10000).
# PORT=5050
# Gunicorn worker count in the container (default 1 — single JSON-state writer).
# WEB_CONCURRENCY=1

# ── AI provider / model ───────────────────────────────────────────────────────
# Provider selection: anthropic (default) | ollama
# AI_PROVIDER=anthropic
# Model override for the anthropic provider (default claude-opus-4-5).
# CMMC_MODEL=claude-opus-4-5
# Optional Anthropic-compatible gateway base URL (proxy / air-gap).
# ANTHROPIC_BASE_URL=
# Air-gapped / CUI: set AI_PROVIDER=ollama and point OLLAMA_BASE_URL at an
# Anthropic-Messages-compatible gateway in front of a self-hosted Ollama model
# (e.g. LiteLLM). See deployments/AIRGAPPED.md.
# OLLAMA_BASE_URL=http://ollama-gateway:8080
# OLLAMA_MODEL=llama3.1:8b

# ── Observability & hardening ─────────────────────────────────────────────────
# Structured log level: DEBUG | INFO | WARNING | ERROR (default INFO).
# LOG_LEVEL=INFO
# Append-only audit trail path (default: audit.log next to the app).
# AUDIT_LOG_FILE=audit.log
# Same-origin guard for state-changing POSTs (comma-separated). Empty = off.
# ALLOWED_ORIGINS=https://cmmc.example.com
